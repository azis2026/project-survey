# MongoDB Connection String (e.g. from MongoDB Atlas M0 cluster)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=survey_db

# Security & Session
JWT_SECRET=super-secret-random-key-please-change-in-production

# Default Admin Account (Will be created automatically on first run)
ADMIN_EMAIL=admin@domain.com
ADMIN_PASSWORD=AdminSurveyStrongPassword2026!

# Allowed Frontend URL(s) for CORS (comma-separated if multiple, without trailing slash)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Optional Email / Webhook Integrations
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Survey Kepuasan Layanan
WEBHOOK_CRON_SECRET=
